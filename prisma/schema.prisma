// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  chartOfAccounts ChartOfAccount[]
  partners        Partner[]
  taxApplications TaxApplication[]
  productServices ProductService[]
  invoices        Invoice[]
  payments        Payment[]
  fixedAssets     FixedAsset[]

  bankStatementsImported    BankStatement[]
  bankStatementLinesMatched BankStatementLine[]
}

model Branch {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  isHeadOffice Boolean @default(false)

  journalEntries JournalEntry[]
  journalLines   JournalLine[]
  localPartners  Partner[]
  invoices       Invoice[]
  fixedAssets    FixedAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id             String             @id @default(cuid())
  date           DateTime
  description    String
  reference      String?
  status         JournalEntryStatus @default(DRAFT)
  voucherType    VoucherType
  documentNumber String             @unique
  lines          JournalLine[]

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Self-relation linking a reversal entry back to the POSTED entry it corrects.
  // reversalOfEntryId is @unique so an entry can be reversed at most once —
  // the DB itself rules out double-reversal, not just the service-layer check.
  reversalOfEntryId String?       @unique
  reversalOfEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   JournalEntry? @relation("JournalEntryReversal")

  taxApplications TaxApplication[]

  // Nullable: most JournalEntry rows still come from vouchers, not invoices.
  // The FK lives on Invoice (journalEntryId is @unique there), so this is a
  // pure back-relation with no fields/references of its own.
  invoice Invoice?

  // Same pattern as `invoice` above: the FK lives on Payment
  // (journalEntryId is @unique there), so this is a pure back-relation.
  payment Payment?

  @@index([date])
  @@index([branchId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)
  memo   String?

  // Debit Voucher per-line bank detail fields — populated only on a DEBIT
  // line (never the consolidated credit line) of a DEBIT_VOUCHER JournalEntry
  // whose shared Cash/Bank Account resolves to an AccountSubType.BANK account
  // (see createDebitVoucher in debit-voucher.service.ts). Per-line rather
  // than on JournalEntry because each bill/line may be paid via a different
  // cheque drawn on that same shared account.
  bankName   String?
  chequeNo   String?
  chequeDate DateTime?

  // Bank reconciliation back-relation only — the FK (matchedJournalLineId)
  // lives on BankStatementLine, so this is a pure back-relation with no
  // fields/references of its own and adds no column here, same pattern as
  // JournalEntry.invoice/JournalEntry.payment above.
  matchedBankStatementLine BankStatementLine?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
}

// Counter is shared across all branches — one serial per voucher type per
// month, regardless of which branch created the document (2026-09 decision:
// a per-branch counter made numbers from different branches look like a
// duplicate/break in the same month's series). branchId was deliberately
// removed from the key (and the table): a shared counter row can't
// coherently point at one branch anymore. JournalEntry.branchId is
// untouched — this only affects the numbering counter, not branch tracking.
model DocumentSequence {
  id          String      @id @default(cuid())
  voucherType VoucherType
  yearMonth   String
  lastNumber  Int         @default(0)

  @@unique([voucherType, yearMonth])
}

// Parallel sequence table for invoice numbering (Sector/YYYYMM/Seq, e.g.
// "GS/202608/0001") rather than reusing DocumentSequence. Kept separate
// instead of generalizing DocumentSequence.voucherType into a shared String
// key because the two key types aren't actually the same shape: voucherType
// is a closed 4-value enum (VoucherType) that generateDocumentNumber
// exhaustiveness-checks via a Record lookup, while sector is explicitly
// open-vocabulary free text (the full sector list isn't known yet — see
// Invoice.sector). Loosening the voucher path's enum to a string just to
// share one table would cost real type safety on existing, working code for
// a dimension that doesn't apply to it. This table mirrors DocumentSequence's
// shape 1:1 (same upsert + atomic `increment` pattern will apply in the
// number-generation service), so the two are conceptually and structurally
// identical — just intentionally not the same table.
//
// Counter is shared across all branches per sector+month, same reasoning
// and same 2026-09 change as DocumentSequence above — branchId removed from
// the key and the table.
model InvoiceDocumentSequence {
  id         String @id @default(cuid())
  sector     String
  yearMonth  String
  lastNumber Int    @default(0)

  @@unique([sector, yearMonth])
}

// Vendor Bill numbering (direction: VENDOR on Invoice) does NOT use sector —
// per the locked decision, Vendor Bills get their own separate numbering
// scheme entirely, not Sector/YYYYMM/Seq. Mirrors InvoiceDocumentSequence's
// shape 1:1 minus the sector column, same upsert + atomic `increment`
// pattern (see generateVendorBillNumber in invoice-document-sequence.service.ts).
//
// Counter is shared across all branches per month — one row per yearMonth,
// same 2026-09 change as DocumentSequence/InvoiceDocumentSequence above —
// branchId removed from the key and the table.
model VendorBillDocumentSequence {
  id         String @id @default(cuid())
  yearMonth  String @unique
  lastNumber Int    @default(0)
}

model ChartOfAccount {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type    AccountType
  subType AccountSubType?

  parentId String?
  parent   ChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("ChartOfAccountHierarchy")

  isActive       Boolean @default(true)
  isReconcilable Boolean @default(false)
  isSystem       Boolean @default(false)

  currencyCode       String    @default("BDT")
  openingBalance     Decimal   @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  journalLines JournalLine[]

  incomeProductServices  ProductService[] @relation("ProductServiceIncomeAccount")
  expenseProductServices ProductService[] @relation("ProductServiceExpenseAccount")

  // Fixed asset register — three distinct roles a ChartOfAccount can play
  // for a FixedAsset row (the asset's own balance-sheet head, the contra-
  // asset accumulated depreciation account, and the P&L depreciation
  // expense account). See FixedAsset below.
  fixedAssetsAsAsset               FixedAsset[] @relation("FixedAssetAccount")
  fixedAssetsAsAccumDepreciation   FixedAsset[] @relation("FixedAssetAccumDepreciation")
  fixedAssetsAsDepreciationExpense FixedAsset[] @relation("FixedAssetDepreciationExpense")

  // Bank reconciliation — which BankStatement rows are imported against this
  // account. Eligibility (isReconcilable, above) is enforced in
  // importBankStatement, not a DB constraint.
  bankStatements BankStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}

model Partner {
  id   String      @id @default(cuid())
  type PartnerType // strict discriminator — enforced at the DB level

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?

  tin String // Tax Identification Number
  bin String // Business Identification Number (VAT reg)

  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  routingNumber     String?

  creditTermsDays Int? // payment terms, e.g. net 30

  // Case-by-case per vendor, per business requirement — not a global rule
  vatInclusiveInPrice Boolean? // true = vendor's quoted price already includes VAT

  // TDS exemption — respected per-partner when tax is calculated on
  // transactions involving this partner
  tdsExempt              Boolean   @default(false)
  tdsExemptionCertNumber String?
  tdsExemptionExpiryDate DateTime?

  // Optional: local vendor tied to a specific branch, per requirement —
  // nullable means company-wide (the default/common case)
  localBranchId String?
  localBranch   Branch? @relation(fields: [localBranchId], references: [id])

  isActive Boolean @default(true)

  // Stored (not computed on-demand), per decision — increased at invoice
  // posting time (see postInvoice in invoice.service.ts) and decreased at
  // payment time (see recordPayment in payment.service.ts). AR/customer-
  // receivable only — a CUSTOMER-direction Invoice posting or payment
  // touches this field alone, never payableBalance below.
  outstandingBalance Decimal @default(0) @db.Decimal(18, 2)

  // AP/vendor-payable — fully separate balance from outstandingBalance
  // above. A VENDOR-direction Invoice (Vendor Bill) posting or payment
  // touches this field alone, never outstandingBalance.
  payableBalance Decimal @default(0) @db.Decimal(18, 2)

  // Denormalized running total of open overpayment credit (PartnerCredit),
  // same pattern as outstandingBalance/payableBalance above — updated only
  // by service-layer logic (created/consumed/voided), never a dynamic key.
  creditBalance Decimal @default(0) @db.Decimal(18, 2)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxApplications TaxApplication[]
  invoices        Invoice[]
  fixedAssets     FixedAsset[]
  payments        Payment[]
  credits         PartnerCredit[]

  @@index([type])
  @@index([tin])
}

// Catalog of billable items/services that appear on invoice lines, mapped to
// the ChartOfAccount rows they hit when invoiced. Schema only for now — no
// service/API/UI layer yet, matching how ChartOfAccount/Partner/TaxRate were
// introduced. Deliberately has no default tax rate: tax stays manually
// selected per invoice line, same as vouchers today (see TaxApplication).
model ProductService {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  type        ProductServiceType

  // Default unit price — invoice lines can override this per-invoice, this
  // is just the catalog default
  unitPrice Decimal @default(0) @db.Decimal(18, 2)
  unit      String? // e.g. "per guard/month", "per hour", "per visit" — free
  // text since Protection One's billing units vary (manpower deployment, not
  // just flat products)

  // Account mapping — this is the core purpose of this model
  incomeAccountId String // required: which revenue account this hits when
  // invoiced/sold
  incomeAccount   ChartOfAccount @relation("ProductServiceIncomeAccount", fields: [incomeAccountId], references: [id])

  expenseAccountId String? // optional: which expense/COGS account this hits
  // if there's a cost side (not every service will have one tracked this way
  // yet — e.g. guard service cost is really payroll, which isn't wired up
  // yet, so leave this nullable rather than forcing a placeholder mapping)
  expenseAccount   ChartOfAccount? @relation("ProductServiceExpenseAccount", fields: [expenseAccountId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceLines InvoiceLine[]

  @@index([type])
  @@index([isActive])
}

// Invoice header — represents BOTH a Customer Invoice (direction: CUSTOMER)
// and a Vendor Bill (direction: VENDOR). Customer Invoices are numbered
// Sector/YYYYMM/Seq (e.g. "GS/202608/0001") via InvoiceDocumentSequence,
// shared across all branches; Vendor Bills don't use sector at all and get
// their own separate VB/YYYYMM/Seq numbering via VendorBillDocumentSequence,
// also shared across all branches — see those models and
// invoice-document-sequence.service.ts. Creation eagerly creates a DRAFT
// JournalEntry (journalEntryId is required + @unique, i.e. a strict 1:1),
// mirroring how vouchers already work — no schema gymnastics needed.
// Tax is NOT modeled here: it attaches at the JournalEntry level via the
// existing TaxApplication mechanism (same as vouchers), since
// TaxApplication.journalEntryId already covers an invoice's entry.
// Schema only for now — no service/API/UI layer yet.
model Invoice {
  id            String           @id @default(cuid())
  invoiceNumber String           @unique // auto-generated — Sector/YYYYMM/Seq for
  // CUSTOMER direction, VB/YYYYMM/Seq for VENDOR direction
  direction     InvoiceDirection // CUSTOMER = Customer Invoice, VENDOR = Vendor Bill —
  // required, no default: every row must explicitly say which it is

  sector String? // free text, e.g. "GS", "CC" — full sector list isn't known
  // yet, so this is intentionally not an enum (same precedent as
  // TaxRate.category). Only meaningful for direction: CUSTOMER — Vendor
  // Bills don't use sector at all, so this is null for direction: VENDOR.

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  partnerId String // direction: CUSTOMER must reference a CUSTOMER-type
  // Partner, direction: VENDOR must reference a VENDOR-type Partner —
  // enforced in the service layer, not a DB constraint (Prisma can't check
  // the enum value of a related row at the FK level)
  partner   Partner @relation(fields: [partnerId], references: [id])

  date    DateTime
  dueDate DateTime?

  status InvoiceStatus @default(DRAFT)

  // Eagerly created at invoice creation time, mirrors voucher pattern —
  // required, not nullable, and 1:1 (an invoice has exactly one JournalEntry)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  subtotal   Decimal @default(0) @db.Decimal(18, 2)
  taxTotal   Decimal @default(0) @db.Decimal(18, 2)
  grandTotal Decimal @default(0) @db.Decimal(18, 2)
  amountPaid Decimal @default(0) @db.Decimal(18, 2)

  notes String?

  lines              InvoiceLine[]
  paymentAllocations PaymentAllocation[]
  creditApplications CreditApplication[]

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerId])
  @@index([branchId])
  @@index([status])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productServiceId String? // nullable — allow a free-text line that isn't
  // tied to the catalog, in case Protection One needs an ad-hoc billing line
  productService   ProductService? @relation(fields: [productServiceId], references: [id])

  description String // required regardless — either copied from
  // ProductService or typed fresh
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(18, 2)
  lineTotal   Decimal @db.Decimal(18, 2)

  sortOrder Int @default(0)

  @@index([invoiceId])
}

// Phase 4: a payment received from (or made to) a Partner, which can now
// fund multiple invoices (PaymentAllocation) and/or leave money over as an
// overpayment credit (PartnerCredit) — replacing the Phase 3 minimal
// single-invoice model (direct `invoiceId` FK). Direction (customer receipt
// vs. vendor payment) is inferred from Partner.type — deliberately not
// stored redundantly here. Service-layer invariant (Tuesday): sum of a
// Payment's allocations' amountApplied + its creditGrant.originalAmount (if
// any) must equal amount.
//
// `amount` (here), PaymentAllocation.amountApplied, PartnerCredit.
// originalAmount/remainingAmount, and CreditApplication.amountApplied are
// all also backed by a Postgres CHECK constraint (> 0, except
// remainingAmount which allows exactly 0) — see migration
// 20260907090000_add_payment_amount_check_constraints. Not representable
// declaratively in this schema (Prisma has no CHECK-constraint attribute),
// so it's DB-only and won't show up in a `prisma migrate diff` against this
// file — mirrors payment.schema.ts's Zod `.positive()` validation, per the
// "reject at Zod AND DB" requirement (first CHECK constraints in this repo;
// no prior table has one, including TaxRate/TaxApplication's ratePercent).
model Payment {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  amount    Decimal  @db.Decimal(18, 2)
  date      DateTime
  method    String? // free text for now — "Cash", "Bank Transfer", "Cheque",
  // etc. Not an enum, since reconciliation may need to formalize this
  // alongside real bank-statement matching; keep it simple now.
  reference String? // e.g. cheque number, transaction ref

  // Eagerly created, mirrors the Invoice/JournalEntry pattern — required,
  // not nullable, and 1:1 (a payment has exactly one JournalEntry)
  journalEntryId String       @unique
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  allocations PaymentAllocation[]
  creditGrant PartnerCredit?

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([partnerId])
}

// Join row: how much of a Payment was applied to a given Invoice. No unique
// constraint on [paymentId, invoiceId] — multiple rows for the same pair are
// allowed (e.g. correction scenarios); sum amountApplied across a payment's
// rows for one invoice to get that invoice's total applied. Validation (sums
// must not exceed Payment.amount / an invoice's outstanding total) is
// service-layer, not enforced here.
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amountApplied Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
}

// Overpayment ledger — created when a Payment's amount exceeds what gets
// allocated to invoices. sourcePaymentId is unique: at most one credit per
// overpaying Payment. Consumption against a later invoice is tracked via
// CreditApplication and applied by manual selection, not auto-applied to a
// partner's next new invoice — per the 2026-09-06 decision (revisit before
// building auto-apply).
model PartnerCredit {
  id        String  @id @default(cuid())
  partnerId String
  partner   Partner @relation(fields: [partnerId], references: [id])

  sourcePaymentId String  @unique
  sourcePayment   Payment @relation(fields: [sourcePaymentId], references: [id])

  originalAmount  Decimal      @db.Decimal(18, 2)
  remainingAmount Decimal      @db.Decimal(18, 2)
  status          CreditStatus @default(OPEN)

  applications CreditApplication[]

  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([status])
}

// Tracks later consumption of a PartnerCredit against an invoice.
model CreditApplication {
  id       String        @id @default(cuid())
  creditId String
  credit   PartnerCredit @relation(fields: [creditId], references: [id])

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  amountApplied Decimal  @db.Decimal(18, 2)
  appliedAt     DateTime @default(now())

  @@index([creditId])
  @@index([invoiceId])
}

// Admin-maintained reference list of VAT rates (e.g. Standard 15%, Exempt
// 0%) that users pick from per transaction. Despite `type` still being the
// full TaxType enum, only VAT rows are realistically created/used here going
// forward: per the clarified requirements, TDS and VDS have NO admin-managed
// rate list — they're fully manual percent entry on TaxApplication instead
// (see below). `type` is kept as TaxType (not narrowed to a VAT-only enum)
// for schema flexibility, but a future reader should not expect TDS/VDS rows
// in this table to be used by the calculation flow.
model TaxRate {
  id       String  @id @default(cuid())
  type     TaxType
  category String // Now that Truncated VAT is confirmed out of scope, this is
  // effectively just "Standard" / "Exempt" for VAT. Left as free text per the
  // earlier decision rather than an enum — tell me if you want it narrowed
  // further now that the category list is this short.
  name     String // display label, e.g. "Standard VAT 15%"

  // VAT is capped at 15% and must support fractional values (7.50, 2.25) —
  // enforced via Zod at the input boundary (not a DB check constraint) so the
  // ceiling can move without a migration.
  ratePercent Decimal @db.Decimal(5, 2)

  // Input (purchases) vs Output (sales) VAT — separate rate lists per the
  // clarified requirements. Required (not nullable) here since every rate
  // list entry needs a list to belong to; TaxApplication.direction is
  // nullable instead, since it's only meaningful for VAT rows there.
  direction TaxDirection

  // How ratePercent applies to a given amount. Defaults to EXCLUSIVE (the
  // common case for TDS/VDS deductions); VAT inclusivity is more often
  // partner-specific (see Partner.vatInclusiveInPrice) — this is just the
  // rate-level fallback.
  computationType TaxComputationType @default(EXCLUSIVE)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = currently in effect, no end date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rows referencing this rate for traceability only — the applied
  // ratePercent is denormalized onto TaxApplication itself, so edits here
  // never retroactively change historical applications.
  taxApplications TaxApplication[]

  @@index([type, category])
  @@index([isActive])
}

// Records the actual tax applied to a transaction. ratePercent is captured
// (denormalized) at entry time rather than looked up live from TaxRate, so
// historical accuracy holds even after the TaxRate list changes later. Tax
// lines compute automatically and post as part of the parent JournalEntry's
// normal Draft->Posted flow — there is no separate approval/review state.
model TaxApplication {
  id String @id @default(cuid())

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  taxType   TaxType // VAT, TDS, or VDS
  direction TaxDirection? // relevant for VAT only (input/output); null for TDS/VDS

  // The rate actually used, captured at entry time — this is the source of
  // truth for historical accuracy, NOT a live lookup. For VAT this is copied
  // from the picked TaxRate; for TDS/VDS this is the manually-typed percent
  // (0-15, fractional allowed — enforced via Zod, same as TaxRate.ratePercent).
  ratePercent Decimal @db.Decimal(5, 2)

  // For VAT only: which TaxRate list entry was picked, kept for traceability
  // ONLY — ratePercent above is still the authoritative value even if this
  // TaxRate row is later edited or deactivated. Always null for TDS/VDS,
  // since those have no admin-managed list to reference.
  sourceTaxRateId String?
  sourceTaxRate   TaxRate? @relation(fields: [sourceTaxRateId], references: [id])

  computationType TaxComputationType // inclusive/exclusive, per this specific application

  baseAmount Decimal @db.Decimal(18, 2) // amount tax is calculated on
  taxAmount  Decimal @db.Decimal(18, 2) // calculated result

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([journalEntryId])
  @@index([partnerId])
}

// Fixed asset register — Phase 4.5. Records what's owned and its
// depreciation parameters so a future depreciation-posting service has
// something to run against. Schema only for now: no service/API/UI layer,
// no depreciation calculation logic yet, matching how ChartOfAccount/
// Partner/TaxRate/ProductService were each introduced schema-first.
model FixedAsset {
  id          String  @id @default(cuid())
  code        String  @unique // asset tag/register number
  name        String
  description String?

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // The ChartOfAccount this asset's value rolls up to on the balance sheet
  // (the "Sundry/Fixed Assets" head or a relevant sub-account). Neither that
  // head nor an Accumulated Depreciation account exists in ChartOfAccount
  // yet (see PROJECT_NOTES.md) — one must be created before any real
  // FixedAsset row can be inserted, since all three account FKs below are
  // required.
  assetAccountId String
  assetAccount   ChartOfAccount @relation("FixedAssetAccount", fields: [assetAccountId], references: [id])

  // Where accumulated depreciation posts — separate contra-asset account,
  // required now even though depreciation posting isn't built yet, since
  // the register needs to know where it WILL post.
  accumulatedDepreciationAccountId String
  accumulatedDepreciationAccount   ChartOfAccount @relation("FixedAssetAccumDepreciation", fields: [accumulatedDepreciationAccountId], references: [id])

  // Where periodic depreciation expense posts.
  depreciationExpenseAccountId String
  depreciationExpenseAccount   ChartOfAccount @relation("FixedAssetDepreciationExpense", fields: [depreciationExpenseAccountId], references: [id])

  acquisitionDate    DateTime
  acquisitionCost    Decimal  @db.Decimal(18, 2)
  salvageValue       Decimal  @default(0) @db.Decimal(18, 2)
  usefulLifeMonths   Int // in months, for flexibility — not all assets have
  // whole-year useful lives

  depreciationMethod DepreciationMethod @default(STRAIGHT_LINE)

  // Denormalized running total — updated by future depreciation posting
  // logic, not computed live, same pattern as Partner.outstandingBalance.
  accumulatedDepreciation Decimal @default(0) @db.Decimal(18, 2)

  status           AssetStatus @default(ACTIVE)
  disposalDate     DateTime?
  disposalProceeds Decimal?    @db.Decimal(18, 2)

  partnerId String? // optional: vendor this was purchased from, if relevant
  partner   Partner? @relation(fields: [partnerId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([assetAccountId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  BANK
  CASH
  RECEIVABLE
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  PAYABLE
  EQUITY
  OPERATING_REVENUE
  OTHER_REVENUE
  OPERATING_EXPENSE
  COST_OF_GOODS_SOLD
  OTHER_EXPENSE
}

