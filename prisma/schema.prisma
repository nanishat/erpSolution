// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  chartOfAccounts ChartOfAccount[]
  partners        Partner[]
}

model Branch {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  isHeadOffice Boolean @default(false)

  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  documentSequences DocumentSequence[]
  localPartners     Partner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id             String             @id @default(cuid())
  date           DateTime
  description    String
  reference      String?
  status         JournalEntryStatus @default(DRAFT)
  voucherType    VoucherType
  documentNumber String             @unique
  lines          JournalLine[]

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Self-relation linking a reversal entry back to the POSTED entry it corrects.
  // reversalOfEntryId is @unique so an entry can be reversed at most once —
  // the DB itself rules out double-reversal, not just the service-layer check.
  reversalOfEntryId String?       @unique
  reversalOfEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   JournalEntry? @relation("JournalEntryReversal")

  @@index([date])
  @@index([branchId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)
  memo   String?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
}

model DocumentSequence {
  id          String      @id @default(cuid())
  voucherType VoucherType
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  yearMonth   String
  lastNumber  Int         @default(0)

  @@unique([voucherType, branchId, yearMonth])
}

model ChartOfAccount {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type    AccountType
  subType AccountSubType?

  parentId String?
  parent   ChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("ChartOfAccountHierarchy")

  isActive       Boolean @default(true)
  isReconcilable Boolean @default(false)
  isSystem       Boolean @default(false)

  currencyCode       String    @default("BDT")
  openingBalance     Decimal   @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  journalLines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}

model Partner {
  id   String      @id @default(cuid())
  type PartnerType // strict discriminator — enforced at the DB level

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?

  tin String // Tax Identification Number
  bin String // Business Identification Number (VAT reg)

  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  routingNumber     String?

  creditTermsDays Int? // payment terms, e.g. net 30

  // Case-by-case per vendor, per business requirement — not a global rule
  vatInclusiveInPrice Boolean? // true = vendor's quoted price already includes VAT

  // TDS exemption — respected per-partner when tax is calculated on
  // transactions involving this partner
  tdsExempt              Boolean   @default(false)
  tdsExemptionCertNumber String?
  tdsExemptionExpiryDate DateTime?

  // Optional: local vendor tied to a specific branch, per requirement —
  // nullable means company-wide (the default/common case)
  localBranchId String?
  localBranch   Branch? @relation(fields: [localBranchId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Invoice/payment relations attach here in Phase 3/4

  @@index([type])
  @@index([tin])
}

// Reference table of named VAT/TDS/VDS rates per type/category — rate
// definitions only. Applying a rate to a transaction (including respecting
// Partner.tdsExempt or Partner.vatInclusiveInPrice) is calculation-engine
// work, not modeled here.
model TaxRate {
  id       String  @id @default(cuid())
  type     TaxType
  category String // e.g. "General" for VAT, "Rent"/"Contractor"/"Professional Fees"
  // for TDS — free text for now since the exact category list isn't final;
  // revisit as an enum once the real category list is confirmed.
  name String // display label, e.g. "Standard VAT 15%"

  // VAT is capped at 15% and must support fractional values (7.50, 2.25) —
  // enforced via Zod at the input boundary (not a DB check constraint) so the
  // ceiling can move without a migration.
  ratePercent Decimal @db.Decimal(5, 2)

  // How ratePercent applies to a given amount. Defaults to EXCLUSIVE (the
  // common case for TDS/VDS deductions); VAT inclusivity is more often
  // partner-specific (see Partner.vatInclusiveInPrice) — this is just the
  // rate-level fallback.
  computationType TaxComputationType @default(EXCLUSIVE)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = currently in effect, no end date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, category])
  @@index([isActive])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  BANK
  CASH
  RECEIVABLE
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  PAYABLE
  EQUITY
  OPERATING_REVENUE
  OTHER_REVENUE
  OPERATING_EXPENSE
  COST_OF_GOODS_SOLD
  OTHER_EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum VoucherType {
  DEBIT_VOUCHER
  CREDIT_VOUCHER
  JOURNAL_VOUCHER
  CASH_VOUCHER
}

enum PartnerType {
  CUSTOMER
  VENDOR
}

enum TaxType {
  VAT
  TDS
  VDS
}

enum TaxComputationType {
  INCLUSIVE // rate is already baked into the given amount
  EXCLUSIVE // rate should be added on top of the given amount
}
