  CREDIT_VOUCHER
  JOURNAL_VOUCHER
  CASH_VOUCHER
  // Stamped on the JournalEntry that Invoice creation eagerly creates (see
  // Invoice model) — not a user-selectable voucher type, so it's excluded
  // from the voucher-type picker/form dropdowns (JournalEntryTypePicker.tsx,
  // JournalEntryForm.tsx). Still a real VoucherType because
  // JournalEntry.documentNumber is required + unique regardless of origin,
  // and generateDocumentNumber's short-code lookup needs one.
  INVOICE_VOUCHER
  // Same rationale as INVOICE_VOUCHER above, stamped on the JournalEntry
  // that Payment recording eagerly creates (see Payment model /
  // recordPayment in payment.service.ts) — not user-selectable either.
  PAYMENT_VOUCHER
}

enum PartnerType {
  CUSTOMER
  VENDOR
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum InvoiceDirection {
  CUSTOMER // Customer Invoice — AR, updates Partner.outstandingBalance
  VENDOR // Vendor Bill — AP, updates Partner.payableBalance
}

