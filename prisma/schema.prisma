// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  chartOfAccounts ChartOfAccount[]
  partners        Partner[]
  taxApplications TaxApplication[]
  productServices ProductService[]
}

model Branch {
  id           String  @id @default(cuid())
  name         String
  code         String  @unique
  isHeadOffice Boolean @default(false)

  journalEntries    JournalEntry[]
  journalLines      JournalLine[]
  documentSequences DocumentSequence[]
  localPartners     Partner[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JournalEntry {
  id             String             @id @default(cuid())
  date           DateTime
  description    String
  reference      String?
  status         JournalEntryStatus @default(DRAFT)
  voucherType    VoucherType
  documentNumber String             @unique
  lines          JournalLine[]

  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Self-relation linking a reversal entry back to the POSTED entry it corrects.
  // reversalOfEntryId is @unique so an entry can be reversed at most once —
  // the DB itself rules out double-reversal, not just the service-layer check.
  reversalOfEntryId String?       @unique
  reversalOfEntry   JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id])
  reversedByEntry   JournalEntry? @relation("JournalEntryReversal")

  taxApplications TaxApplication[]

  @@index([date])
  @@index([branchId])
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  accountId String
  account   ChartOfAccount @relation(fields: [accountId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  debit  Decimal @default(0) @db.Decimal(18, 2)
  credit Decimal @default(0) @db.Decimal(18, 2)
  memo   String?

  @@index([journalEntryId])
  @@index([accountId])
  @@index([branchId])
}

model DocumentSequence {
  id          String      @id @default(cuid())
  voucherType VoucherType
  branchId    String
  branch      Branch      @relation(fields: [branchId], references: [id])
  yearMonth   String
  lastNumber  Int         @default(0)

  @@unique([voucherType, branchId, yearMonth])
}

model ChartOfAccount {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  type    AccountType
  subType AccountSubType?

  parentId String?
  parent   ChartOfAccount?  @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id])
  children ChartOfAccount[] @relation("ChartOfAccountHierarchy")

  isActive       Boolean @default(true)
  isReconcilable Boolean @default(false)
  isSystem       Boolean @default(false)

  currencyCode       String    @default("BDT")
  openingBalance     Decimal   @default(0) @db.Decimal(18, 2)
  openingBalanceDate DateTime?

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  journalLines JournalLine[]

  incomeProductServices  ProductService[] @relation("ProductServiceIncomeAccount")
  expenseProductServices ProductService[] @relation("ProductServiceExpenseAccount")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([parentId])
}

model Partner {
  id   String      @id @default(cuid())
  type PartnerType // strict discriminator — enforced at the DB level

  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?

  tin String // Tax Identification Number
  bin String // Business Identification Number (VAT reg)

  bankName          String?
  bankAccountNumber String?
  bankBranch        String?
  routingNumber     String?

  creditTermsDays Int? // payment terms, e.g. net 30

  // Case-by-case per vendor, per business requirement — not a global rule
  vatInclusiveInPrice Boolean? // true = vendor's quoted price already includes VAT

  // TDS exemption — respected per-partner when tax is calculated on
  // transactions involving this partner
  tdsExempt              Boolean   @default(false)
  tdsExemptionCertNumber String?
  tdsExemptionExpiryDate DateTime?

  // Optional: local vendor tied to a specific branch, per requirement —
  // nullable means company-wide (the default/common case)
  localBranchId String?
  localBranch   Branch? @relation(fields: [localBranchId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taxApplications TaxApplication[]

  // Invoice/payment relations attach here in Phase 3/4

  @@index([type])
  @@index([tin])
}

// Catalog of billable items/services that appear on invoice lines, mapped to
// the ChartOfAccount rows they hit when invoiced. Schema only for now — no
// service/API/UI layer yet, matching how ChartOfAccount/Partner/TaxRate were
// introduced. Deliberately has no default tax rate: tax stays manually
// selected per invoice line, same as vouchers today (see TaxApplication).
model ProductService {
  id          String             @id @default(cuid())
  code        String             @unique
  name        String
  description String?
  type        ProductServiceType

  // Default unit price — invoice lines can override this per-invoice, this
  // is just the catalog default
  unitPrice Decimal @default(0) @db.Decimal(18, 2)
  unit      String? // e.g. "per guard/month", "per hour", "per visit" — free
  // text since Protection One's billing units vary (manpower deployment, not
  // just flat products)

  // Account mapping — this is the core purpose of this model
  incomeAccountId String // required: which revenue account this hits when
  // invoiced/sold
  incomeAccount ChartOfAccount @relation("ProductServiceIncomeAccount", fields: [incomeAccountId], references: [id])

  expenseAccountId String? // optional: which expense/COGS account this hits
  // if there's a cost side (not every service will have one tracked this way
  // yet — e.g. guard service cost is really payroll, which isn't wired up
  // yet, so leave this nullable rather than forcing a placeholder mapping)
  expenseAccount ChartOfAccount? @relation("ProductServiceExpenseAccount", fields: [expenseAccountId], references: [id])

  isActive Boolean @default(true)

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // InvoiceLine relation attaches here in the next Phase 3 schema step

  @@index([type])
  @@index([isActive])
}

// Admin-maintained reference list of VAT rates (e.g. Standard 15%, Exempt
// 0%) that users pick from per transaction. Despite `type` still being the
// full TaxType enum, only VAT rows are realistically created/used here going
// forward: per the clarified requirements, TDS and VDS have NO admin-managed
// rate list — they're fully manual percent entry on TaxApplication instead
// (see below). `type` is kept as TaxType (not narrowed to a VAT-only enum)
// for schema flexibility, but a future reader should not expect TDS/VDS rows
// in this table to be used by the calculation flow.
model TaxRate {
  id       String  @id @default(cuid())
  type     TaxType
  category String // Now that Truncated VAT is confirmed out of scope, this is
  // effectively just "Standard" / "Exempt" for VAT. Left as free text per the
  // earlier decision rather than an enum — tell me if you want it narrowed
  // further now that the category list is this short.
  name     String // display label, e.g. "Standard VAT 15%"

  // VAT is capped at 15% and must support fractional values (7.50, 2.25) —
  // enforced via Zod at the input boundary (not a DB check constraint) so the
  // ceiling can move without a migration.
  ratePercent Decimal @db.Decimal(5, 2)

  // Input (purchases) vs Output (sales) VAT — separate rate lists per the
  // clarified requirements. Required (not nullable) here since every rate
  // list entry needs a list to belong to; TaxApplication.direction is
  // nullable instead, since it's only meaningful for VAT rows there.
  direction TaxDirection

  // How ratePercent applies to a given amount. Defaults to EXCLUSIVE (the
  // common case for TDS/VDS deductions); VAT inclusivity is more often
  // partner-specific (see Partner.vatInclusiveInPrice) — this is just the
  // rate-level fallback.
  computationType TaxComputationType @default(EXCLUSIVE)

  isActive      Boolean   @default(true)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime? // null = currently in effect, no end date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Rows referencing this rate for traceability only — the applied
  // ratePercent is denormalized onto TaxApplication itself, so edits here
  // never retroactively change historical applications.
  taxApplications TaxApplication[]

  @@index([type, category])
  @@index([isActive])
}

// Records the actual tax applied to a transaction. ratePercent is captured
// (denormalized) at entry time rather than looked up live from TaxRate, so
// historical accuracy holds even after the TaxRate list changes later.
// Schema only for now — no calculation logic or approval workflow yet.
model TaxApplication {
  id String @id @default(cuid())

  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])

  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])

  taxType   TaxType // VAT, TDS, or VDS
  direction TaxDirection? // relevant for VAT only (input/output); null for TDS/VDS

  // The rate actually used, captured at entry time — this is the source of
  // truth for historical accuracy, NOT a live lookup. For VAT this is copied
  // from the picked TaxRate; for TDS/VDS this is the manually-typed percent
  // (0-15, fractional allowed — enforced via Zod, same as TaxRate.ratePercent).
  ratePercent Decimal @db.Decimal(5, 2)

  // For VAT only: which TaxRate list entry was picked, kept for traceability
  // ONLY — ratePercent above is still the authoritative value even if this
  // TaxRate row is later edited or deactivated. Always null for TDS/VDS,
  // since those have no admin-managed list to reference.
  sourceTaxRateId String?
  sourceTaxRate   TaxRate? @relation(fields: [sourceTaxRateId], references: [id])

  computationType TaxComputationType // inclusive/exclusive, per this specific application

  baseAmount Decimal @db.Decimal(18, 2) // amount tax is calculated on
  taxAmount  Decimal @db.Decimal(18, 2) // calculated result

  // Per business requirement: "tax is auto-calculated but held for manual
  // review/approval before posting to the ledger"
  status          TaxApplicationStatus @default(PENDING_REVIEW)
  rejectionReason String? // set when status transitions to REJECTED; otherwise null

  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([journalEntryId])
  @@index([partnerId])
  @@index([status])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum AccountSubType {
  CURRENT_ASSET
  FIXED_ASSET
  BANK
  CASH
  RECEIVABLE
  CURRENT_LIABILITY
  LONG_TERM_LIABILITY
  PAYABLE
  EQUITY
  OPERATING_REVENUE
  OTHER_REVENUE
  OPERATING_EXPENSE
  COST_OF_GOODS_SOLD
  OTHER_EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  VOID
}

enum VoucherType {
  DEBIT_VOUCHER
  CREDIT_VOUCHER
  JOURNAL_VOUCHER
  CASH_VOUCHER
}

enum PartnerType {
  CUSTOMER
  VENDOR
}

enum ProductServiceType {
  PRODUCT
  SERVICE
}

enum TaxType {
  VAT
  TDS
  VDS
}

enum TaxComputationType {
  INCLUSIVE // rate is already baked into the given amount
  EXCLUSIVE // rate should be added on top of the given amount
}

enum TaxDirection {
  INPUT // purchases
  OUTPUT // sales
}

enum TaxApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}
